# Committed production defaults.
#
# These two values are publishable by design: the Supabase URL and the
# publishable (anon) key are embedded in the client bundle on every request,
# and Row Level Security — not key secrecy — is what protects the data (§15).
# The app holds no service-role key anywhere.
#
# Real environment variables always win over this file, so a Vercel/host env
# var overrides any line here without a code change.
NEXT_PUBLIC_SUPABASE_URL=https://atactzwivgfxewsnwozr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_0ImxL2RPoEvRO1P2PUE7Bg_d2fFDwb3

# Notification gateway: logs instead of sending until credentials are set.
SMS_PROVIDER=console
SMS_OTP_PATTERN=asaex-otp

# Rates
RATE_STALE_SECONDS=180
RATE_REFRESH_SECONDS=60
RATES_DEMO_MODE=false
