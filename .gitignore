# dependencies
/node_modules
.pnpm-store

# next.js
/.next/
/out/
next-env.d.ts

# serwist (generated service worker)
/public/sw.js
/public/sw.js.map
/public/swe-worker*.js

# production
/build

# misc
.DS_Store
*.pem
/artifacts

# debug
npm-debug.log*
pnpm-debug.log*

# env files — never commit real secrets
.env
.env.local
.env.*.local

# typescript
*.tsbuildinfo

# testing
/coverage
/playwright-report
/test-results

# Throwaway verification scripts — kept out of the repo, not out of the way.
scripts/tmp/

# Python bytecode from the throwaway message-editing scripts
__pycache__/

# The deployment's secrets. Generated on the server by
# deploy/scripts/gen-secrets.sh and never committed — it holds the JWT signing
# key, the database password and the backup passphrase.
deploy/.env
deploy/.env.*
!deploy/.env.example
