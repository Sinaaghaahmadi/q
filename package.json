{
  "name": "asaex",
  "version": "0.1.0",
  "private": true,
  "description": "Asaex (صرافی آسا) — currency exchange & remittance marketplace. Customer PWA + Exchange-Office Panel + Super-Admin Panel.",
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/sync-fonts.mjs && next dev",
    "build": "node scripts/sync-fonts.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:assets": "tsx scripts/generate-brand-assets.mts",
    "seed:demo": "tsx scripts/seed-demo.mts",
    "prepare": "husky || true",
    "budget": "node scripts/check-budget.mjs",
    "messages:merge": "node scripts/merge-messages.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@serwist/next": "^9.1.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.85.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.540.0",
    "next": "^15.5.0",
    "next-intl": "^4.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/eslintrc": "^3.3.1",
    "@fontsource-variable/inter": "^5.2.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^15.5.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "serwist": "^9.1.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vazirmatn": "^33.0.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
