# ── Asaex environment ─────────────────────────────────────────────────────────
# Copy to .env.local for local development. Server-only secrets must never use
# the NEXT_PUBLIC_ prefix (§15).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Rates engine (§7) ────────────────────────────────────────────────────────
# Primary source: tgju.org (verified endpoints in docs/integrations/tgju.md).
# The public widget endpoint needs no key. If you obtain a commercial
# api.tgju.org key, set it here and TgjuProvider will switch to it.
TGJU_API_KEY=
# Seconds after which a rate is considered stale and the UI shows "degraded".
RATE_STALE_SECONDS=180
# Poll interval for the server-side snapshot refresher (seconds).
RATE_REFRESH_SECONDS=60
# Force the seeded demo provider (true/false). With false the app still falls
# back to demo data automatically when upstream sources are unreachable.
RATES_DEMO_MODE=false

# ── Supabase (Phase 2+) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Notifications (Phase 3) ──────────────────────────────────────────────────
RESEND_API_KEY=
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
SMSIR_API_KEY=
GHASEDAK_API_KEY=

# ── Observability (Phase 7) ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
