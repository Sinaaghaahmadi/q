# ── Asaex environment ─────────────────────────────────────────────────────────
# Copy to .env.local for local development. Server-only secrets must never use
# the NEXT_PUBLIC_ prefix (§15).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Rates engine (§7) ────────────────────────────────────────────────────────
# Primary source: tgju.org (verified endpoints in docs/integrations/tgju.md).
# The public widget endpoint needs no key. If you obtain a commercial
# api.tgju.org key, set it here and TgjuProvider will switch to it.
TGJU_API_KEY=
# Seconds after which a rate is considered stale and the UI shows "degraded".
RATE_STALE_SECONDS=180
# Poll interval for the server-side snapshot refresher (seconds).
RATE_REFRESH_SECONDS=60
# Force the seeded demo provider (true/false). With false the app still falls
# back to demo data automatically when upstream sources are unreachable.
RATES_DEMO_MODE=false

# ── Supabase (Phase 2+) ──────────────────────────────────────────────────────
# The app deliberately holds no service-role key: everything runs on the
# publishable key under RLS, and privileged work goes through SECURITY DEFINER
# database functions that check the caller's role themselves (§15).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# `console` logs messages instead of sending — the default until gateway
# credentials exist. Set to `kavenegar` once KAVENEGAR_API_KEY is filled in.
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Pre-approved OTP pattern registered with the gateway (§12).
SMS_OTP_PATTERN=asaex-otp
# Shared secret for the Supabase Auth "Send SMS" hook, set on both sides.
SEND_SMS_HOOK_SECRET=

# ── Observability (Phase 7) ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
