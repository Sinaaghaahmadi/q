# ---------- Asameet environment ----------

# Public URL of the app (used in metadata / share links)
NEXT_PUBLIC_APP_URL=https://asameet.online

# Realtime chat service (mini-services/chat-service).
# Leave empty on serverless demo deployments — the app falls back to polling.
NEXT_PUBLIC_SOCKET_URL=

# AI assistant (meeting minutes / summaries / brainstorming).
# Without a key the /api/ai route serves polished demo output.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
ASAMEET_AI_MODEL=

# Database for the self-hosted Prisma deployment (SQLite file or PostgreSQL URL)
DATABASE_URL=file:./db/asameet.db
